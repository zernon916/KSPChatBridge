# One Aider/Qwen pass per loop: first unchecked task in QWEN_PLAN.md -> Aider (task text in the message, only the task's files
# in the chat), then the SCRIPT builds, tests, marks [x], logs to QWENCHANGED.md and commits if green. Never pushes.
# Honours the first "STOP HERE" line. Task IDs: letters + digits + optional letter (TB7a, R3, H10, T12). ASCII only.
param([int]$Loop = 1, [int]$MaxTokens = 21500, [string]$Model = "")
$ErrorActionPreference = 'Continue'
$root = $PSScriptRoot; Set-Location $root
$aider = Join-Path $env:USERPROFILE '.local\bin\aider.exe'; if (-not (Test-Path $aider)) { $aider = 'aider' }
$never = @('CURSOR_TODO.md','tools/package_release.ps1','AUTOPILOT_REVIEW.md','REPORT.7.9.MD','MECHJEB_IDEAS.md','QWEN_PLAN.md','QWEN_PLAN.old.md','QWEN_PLAN.pre-micro.md','QWENCHANGED.md','qwen_pass.ps1','qwen_pass.ps1.bak','qwen_pass.ps1.bak2','qwen_pass.ps1.bak3','NOTES.md','CHEATSHEET.md','ROCKET_PLAN.md','CLINE_TABLET.md','SPACEDOCK_DESC.md','codex_pass.ps1','codex_pass.ps1.bak','codex_pass.log')
$ksp = @($env:KSPDir,'C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program','C:\Steam\steamapps\common\Kerbal Space Program') | Where-Object { $_ -and (Test-Path "$_\KSP_x64.exe") } | Select-Object -First 1
$enc = New-Object System.Text.UTF8Encoding($false)
function Log($m) { $l = "$(Get-Date -f 'yyyy-MM-dd HH:mm:ss') $m"; Write-Host $l; Add-Content (Join-Path $root 'qwen_pass.log') $l }
function NextTask { Select-String -Path QWEN_PLAN.md -Pattern '^\s*- \[ \] ([A-Za-z]+\d+[a-z]?):' | Select-Object -First 1 }
function RulesText {
    $lines = [IO.File]::ReadAllLines((Join-Path $root 'QWEN_PLAN.md'), $enc); $out = @(); $in = $false
    foreach ($l in $lines) { if ($l -match '^## RULES') { $in = $true; continue }; if ($in -and $l -match '^## ') { break }; if ($in -and $l.Trim().Length -gt 0) { $out += $l } }
    # essentials only: drop the never-commit list and build/install lines (the script does those)
    ($out | Where-Object { $_ -notmatch 'NEVER commit|^- Build|^- Tests|^- Install|One git commit|NOTES.md' }) -join "`n"
}
function TaskFiles($text) {
    $found = [ordered]@{}
    foreach ($m in [regex]::Matches($text, '(?:KSPChatMod/)?([A-Za-z0-9_]+\.cs)(\s*\((new|template|read only)[^)]*\))?')) {
        $name = $m.Groups[1].Value; $tag = $m.Groups[3].Value; $path = "KSPChatMod/$name"
        if (-not $found.Contains($path)) { $found[$path] = $tag } elseif ($tag) { $found[$path] = $tag }
    }
    $found
}

for ($i = 1; $i -le $Loop; $i++) {
    $next = NextTask; if (-not $next) { Log 'No unchecked tasks left.'; break }
    $id = $next.Matches[0].Groups[1].Value
    $stopLine = (Select-String -Path QWEN_PLAN.md -Pattern 'STOP HERE' | Select-Object -First 1).LineNumber
    if ($stopLine -and $next.LineNumber -gt $stopLine) { Log "Next task $id is past STOP HERE; stopping."; break }
    $task = $next.Line.Trim() -replace '^- \[ \] ', ''
    $title = ($task -replace "^${id}:\s*", ''); if ($title.Length -gt 60) { $title = $title.Substring(0, 60).Trim() }
    $files = TaskFiles $task
    $edit = @(); $read = @('KSPChatMod/TabletTrim.cs'); $create = @()
    foreach ($k in $files.Keys) {
        $full = Join-Path $root $k
        if ($k -eq 'KSPChatMod/TabletTrim.cs') { continue }
        if (Test-Path $full) { if ($files[$k] -match 'read only|template') { $read += $k } else { $edit += $k } }
        else { $create += $k }
    }
    # big files (>600 lines) blow the context: drop them; tasks should point at a qwen_ctx/ snippet instead
    $edit = @($edit | Where-Object { $n = (Get-Content (Join-Path $root $_)).Count; if ($n -gt 600) { Log "skipping big file $_ ($n lines) - use a qwen_ctx snippet"; $false } else { $true } })
    foreach ($m in [regex]::Matches($task, 'qwen_ctx/[A-Za-z0-9_.\-]+')) { if (Test-Path (Join-Path $root $m.Value)) { $read += $m.Value } }
    $msg = "You are editing a KSP 1.12 C# mod (Unity IMGUI, .NET 4.7.2, C# 7.3). Do exactly ONE task, then stop.`n`nRULES:`n" + (RulesText) +
        "`n`nTASK ${task}`n`nNotes: the files you need are already in the chat (read-only ones are for reference only). " +
        $(if ($create) { "Create these NEW files (full content, in a SEARCH/REPLACE block with an empty SEARCH section): " + ($create -join ', ') + ". " } else { '' }) +
        "Keep edits small, at the named anchor. Do not edit any other file, do not run commands, do not touch QWEN_PLAN.md or QWENCHANGED.md (the script marks the task done)."
    $chars = $msg.Length; foreach ($f in ($edit + $read)) { $chars += (Get-Item (Join-Path $root $f)).Length }
    $est = [int]($chars / 3.5) + 8500   # + Aider system prompt / edit-format overhead (TB11a: estimate 12.3k, Aider reported 21k sent)
    Log "=== Pass $i/$Loop : $id (edit: $($edit -join ' '); create: $($create -join ' '); read: $($read -join ' ')) ~$est tokens ==="
    if ($est -gt $MaxTokens) { Log "task too big ($est > $MaxTokens tokens); stopping."; Add-Content QWENCHANGED.md "`n- $(Get-Date -f 'yyyy-MM-dd HH:mm') BLOCKED: $id task too big for the local model (~$est tokens)."; break }
    $msgFile = Join-Path $env:TEMP ('qwen_msg_' + $id + '.txt'); [IO.File]::WriteAllText($msgFile, $msg, $enc)   # one arg: a multi-line --message gets split into words by PowerShell -> Aider treats them as files
    $aargs = @('--yes-always', '--map-tokens', '0', '--no-auto-lint', '--no-auto-test', '--no-restore-chat-history', '--message-file', $msgFile)
    foreach ($f in ($edit + $create)) { $aargs += @('--file', $f) }
    foreach ($f in $read) { $aargs += @('--read', $f) }
    if ($Model) { $aargs += @("--model", $Model) }; & $aider @aargs 2>&1 | Tee-Object -Variable aout
    Log "aider exit $LASTEXITCODE"
    $atext = ($aout | Out-String); $tok = [regex]::Matches($atext, 'Tokens: [^\r\n]+') | Select-Object -Last 1; if ($tok) { Log "aider $($tok.Value)" }
    if ($atext -match 'exceeds the') { Log 'Token limit exceeded; stopping.'; Add-Content QWENCHANGED.md "`n- $(Get-Date -f 'yyyy-MM-dd HH:mm') BLOCKED: $id hit the token limit."; break }
    $changed = @(git status --porcelain --untracked-files=all | ForEach-Object { $p = $_.Substring(3).Trim('"'); if ($p -match ' -> ') { $p = ($p -split ' -> ')[1] }; $p } |
        Where-Object { $never -notcontains $_ -and $_ -notlike '.aider*' -and $_ -ne 'qwen_pass.log' -and $_ -notmatch '(^|/)(bin|obj|dist)/' -and $_ -notmatch '^codex_pass_.*\.txt$' -and ($_ -like 'KSPChatMod/*' -or $_ -like 'tests/*') })   # code files only
    if (-not $changed) { Log "$id : model changed no files; stopping."; Add-Content QWENCHANGED.md "`n- $(Get-Date -f 'yyyy-MM-dd HH:mm') BLOCKED: $id - model changed no files."; break }
    $empty = @($changed | Where-Object { (Test-Path $_) -and (Get-Item $_).Length -eq 0 }); if ($empty) { Log "$id : empty file(s) $($empty -join ', '); stopping."; Add-Content QWENCHANGED.md "`n- $(Get-Date -f 'yyyy-MM-dd HH:mm') BLOCKED: $id left empty files $($empty -join ', ')."; break }
    Push-Location (Join-Path $root 'KSPChatMod')
    $bargs = @('build','-c','Release','-nologo','-v','q'); if ($ksp) { $bargs += "-p:KSPDir=$ksp" }
    if (Get-Process KSP_x64 -ErrorAction SilentlyContinue) { $bargs += '-p:SkipInstall=true'; Log 'KSP running: build without install' }
    $bout = & dotnet @bargs 2>&1; $ok = ($LASTEXITCODE -eq 0)
    Pop-Location
    if (-not $ok) { Log "BUILD FAILED after $id"; ($bout | Select-String ' error ' | Select-Object -First 8) | ForEach-Object { Log "  $($_.Line.Trim())" }; Add-Content QWENCHANGED.md "`n- $(Get-Date -f 'yyyy-MM-dd HH:mm') BLOCKED: $id build failed; changes left uncommitted ($($changed -join ', '))."; break }
    & dotnet run -c Release --project (Join-Path $root 'tests\csharp') 2>&1 | Out-Null
    if ($LASTEXITCODE -ne 0) { Log "TESTS FAILED after $id"; Add-Content QWENCHANGED.md "`n- $(Get-Date -f 'yyyy-MM-dd HH:mm') BLOCKED: $id tests failed; changes left uncommitted."; break }
    # green: the script marks the task and logs it
    $planPath = Join-Path $root 'QWEN_PLAN.md'; $plan = [IO.File]::ReadAllText($planPath, $enc)
    $plan = ([regex]('(?m)^(\s*)- \[ \] ' + [regex]::Escape($id) + ':')).Replace($plan, '$1- [x] ' + $id + ':', 1)
    $plan = ([regex]('(?m)^(\s*- \[x\] ' + [regex]::Escape($id) + ':[^\r\n]*)(\r?\n)')).Replace($plan, '$1$2  done: qwen_pass ' + (Get-Date -f 'yyyy-MM-dd HH:mm') + ', files ' + ($changed -join ', ') + '$2', 1)
    [IO.File]::WriteAllText($planPath, $plan, $enc)
    git add -N -- $changed 2>$null | Out-Null
    $stat = (git diff --stat -- $changed | Out-String).TrimEnd()
    Add-Content QWENCHANGED.md "`n## $id - $(Get-Date -f 'yyyy-MM-dd HH:mm')`n$title`n``````n$stat`n``````"
    git add -- $changed; git commit -m "QWEN ${id}: $title" -- $changed | Out-Null; Log "Committed ${id}: $($changed -join ', ')"
}
Log 'done'